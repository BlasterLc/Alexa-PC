# Replace YOUR_USER (and the paths) with your Linux user before installing.
[Unit]
Description=Cloudflare Tunnel ytmusic
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/YOUR_USER/.cloudflared/config.yml run ytmusic
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
