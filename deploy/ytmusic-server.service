# Replace YOUR_USER (and the paths) with your Linux user before installing.
[Unit]
Description=YtMusic-Conec FastAPI Server
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/YtMusic-Conec
ExecStart=/home/YOUR_USER/YtMusic-Conec/.venv/bin/python main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
